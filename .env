# Tag for the Docker images, e.g., 'playerbots', 'master', etc.
DOCKER_IMAGE_TAG=playerbots

# Paths for Docker volumes (relative to your project or filesystem)
# Configuration files directory to be mounted inside the container
DOCKER_VOL_ETC=../config/base

# Directory for log files
DOCKER_VOL_LOGS=../logs

# Database volume directory (enable if needed)
#DOCKER_VOL_DB=../data/db

# Custom SQL scripts directory, mounted for AzerothCore to import custom SQL
DOCKER_VOL_SQL_CUSTOM=./data/sql/custom

# For some reason, the data gets extracted back to client_data folder..
# Just use the same for both vars
DOCKER_VOL_DATA=../data/maps
DOCKER_VOL_CLIENT_DATA=../data/maps

# Project directory structure (relative to project root)
ACORE_LIB_DIR=lib
ACORE_CORE_DIR=azerothcore-wotlk
ACORE_MODULES_DIR=azerothcore-wotlk/modules
ACORE_CUSTOM_SQL_DIR=data/sql/custom
ACORE_BACKUP_SQL_DIR=data/backup

# UI formatting for console or log output (line styles)
ACORE_LINE_LONG=-----------------------------------------------------
ACORE_LINE_SHORT=----

# Git repositories configuration
# Core AzerothCore source repository URL and specific branch to use
GIT_CORE_REPOSITORY="https://github.com/liyunfan1223/azerothcore-wotlk.git --branch=Playerbot"

# Comma-separated list of Git module repositories to clone
GIT_MODULE_REPOSITORIES="https://github.com/azerothcore/mod-individual-xp.git,https://github.com/azerothcore/mod-learn-spells.git,https://github.com/liyunfan1223/mod-playerbots.git"
